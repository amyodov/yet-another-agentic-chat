{
  "description": "Hands this session the messages other sessions have sent it, and hands back the connections it holds when a compaction replaces what it knew. Silent when there is nothing to say.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:yaac:yaac",
            "tool": "hook_report",
            "input": {
              "event": "PreToolUse",
              "tool_name": "${tool_name}"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:yaac:yaac",
            "tool": "hook_report",
            "input": {
              "event": "UserPromptSubmit"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:yaac:yaac",
            "tool": "hook_report",
            "input": {
              "event": "Stop"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:yaac:yaac",
            "tool": "hook_report",
            "input": {
              "event": "SessionStart"
            }
          }
        ]
      }
    ]
  }
}
